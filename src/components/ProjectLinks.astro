---
import ProjectLink from './ProjectLink.astro';
import type { ProjectLink as ProjectLinkData } from '../data/projects';

interface Props {
	links: ProjectLinkData[];
}

const { links } = Astro.props;
---

<div class="project-links">
	<h2
		class="project-links__title mb-3 text-xs font-semibold tracking-[0.05em] uppercase text-neutral-500"
	>
		Links
	</h2>
	<ul class="project-links__list m-0 flex list-none flex-wrap gap-3 p-0">
		{
			links.map((link) => (
				<li class="project-links__item">
					<ProjectLink link={link} />
				</li>
			))
		}
	</ul>
</div>
