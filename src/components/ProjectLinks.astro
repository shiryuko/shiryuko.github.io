---
import ProjectLink from './ProjectLink.astro';
import type { ProjectLink as ProjectLinkData } from '../data/projects';

interface Props {
	links: ProjectLinkData[];
}

const { links } = Astro.props;
---

<div class="project-links">
	<h2 class="project-links__title">Links</h2>
	<ul class="project-links__list">
		{
			links.map((link) => (
				<li class="project-links__item">
					<ProjectLink link={link} />
				</li>
			))
		}
	</ul>
</div>

<style>
	.project-links__title {
		margin: 0 0 0.75rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--color-neutral-500);
	}

	.project-links__list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
</style>
