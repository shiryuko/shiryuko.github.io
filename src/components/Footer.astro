---
import { site } from '../config/site';
import SocialLink from './SocialLink.astro';
---

<footer class="border-t border-neutral-800 bg-neutral-950">
	<div
		class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 py-8 text-sm text-neutral-500 sm:flex-row"
	>
		<p class="m-0">&copy; {new Date().getFullYear()} shiryuko. Built with Astro.</p>

		<nav aria-label="Social links">
			<ul class="m-0 flex list-none items-center gap-4 p-0">
				{site.social.map((link) => (
					<li>
						<SocialLink link={link} />
					</li>
				))}
			</ul>
		</nav>
	</div>
</footer>
