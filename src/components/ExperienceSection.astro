---
import type { ExperienceItem } from '../data/experience';

interface Props {
	items: ExperienceItem[];
}

const { items } = Astro.props;
---

<section id="experience" class="border-t border-neutral-800 bg-neutral-900/40 px-6 py-24">
	<div class="mx-auto max-w-3xl">
		<h2 class="mb-16 text-center text-3xl font-bold tracking-tight text-neutral-50 sm:text-4xl">
			Experience
		</h2>

		<ol class="relative m-0 list-none space-y-12 p-0">
			<div
				class="absolute top-2 bottom-2 left-4 w-px bg-neutral-700 sm:left-1/2 sm:-translate-x-px"
				aria-hidden="true"
			>
			</div>

			{
				items.map((item, index) => (
					<li class="relative pl-12 sm:pl-0">
						<span
							class="absolute top-1.5 left-2.5 size-3 rounded-full border-2 border-red-500 bg-neutral-950 sm:left-1/2 sm:-translate-x-1/2"
							aria-hidden="true"
						/>

						<article
							class:list={[
								'rounded-xl border border-neutral-800 bg-neutral-950 p-6 sm:w-[calc(50%-2rem)]',
								index % 2 === 0 ? 'sm:mr-auto' : 'sm:ml-auto',
							]}
						>
							<header class="mb-4 space-y-1">
								<h3 class="text-xl font-semibold text-neutral-50">{item.name}</h3>
								<time class="text-sm font-medium text-red-500">{item.duration}</time>
							</header>

							<p class="mb-4 text-sm leading-relaxed text-neutral-400">
								{item.description}
							</p>

							<div>
								<h4 class="mb-2 text-xs font-semibold tracking-wider text-neutral-500 uppercase">
									My work
								</h4>
								<p class="text-sm leading-relaxed text-neutral-300">{item.myWork}</p>
							</div>
						</article>
					</li>
				))
			}
		</ol>
	</div>
</section>
