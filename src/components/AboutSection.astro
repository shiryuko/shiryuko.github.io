---
import type { AboutContent } from '../data/about';
import { formatRichText } from '../utils/richText';

interface Props {
	content: AboutContent;
}

const { content } = Astro.props;
---

<section id="about" class="mx-auto max-w-6xl px-6 py-24">
	<div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
		<div class="space-y-6">
			<h2 class="text-4xl font-bold tracking-tight text-neutral-50 sm:text-5xl">
				{content.heading}
			</h2>
			{
				content.paragraphs.map((paragraph) => (
					<p class="text-lg leading-relaxed text-neutral-400" set:html={formatRichText(paragraph)} />
				))
			}
		</div>

		<div class="w-full grid place-items-center">
			<img src={content.photoUrl[0]} class="col-start-1 row-start-1 z-0" />
			<img id="heroEyes" src={content.photoUrl[1]} class="col-start-1 row-start-1 transition-transform duration-75 z-10" />
			<img src={content.photoUrl[2]} class="col-start-1 row-start-1 z-20" />
		</div>
	</div>
</section>

<script>
	const eyes = document.getElementById("heroEyes");
	if (!eyes) throw new Error("AboutSection: #heroEyes not found");

	const SCALE = 10;
	const DEAD_ZONE = 35;
	const SPEED = 20;

	let currentX = 0;
	let currentY = 0;
	let targetX = 0;
	let targetY = 0;
	let lastTime = 0;

	const onMouseMove = (e: MouseEvent) => {
		const rect = eyes.getBoundingClientRect();

		const imgPosCenterX = rect.left+(rect.width/2);
		const imgPosCenterY = rect.top+(rect.height*0.85);

		//Direction Vector [Eyes -> Mouse]
		const vdx = e.clientX - imgPosCenterX;
		const vdy = e.clientY - imgPosCenterY;

		const distance = Math.sqrt(vdx * vdx + vdy * vdy);

		//Normalized & Scaled
		targetX = (vdx/distance) * SCALE;
		targetY = (vdy/distance) * SCALE;

		if (distance < DEAD_ZONE || distance === 0) {
			targetX = 0;
			targetY = 0;
		}
	};

	const animate = (now: DOMHighResTimeStamp) => {
		const delta = lastTime === 0 ? 0 : (now - lastTime)/1000;
		lastTime = now;

		const a = 1 - Math.exp(-SPEED * delta);

		//Interpolate position
		currentX += (targetX - currentX) * a;
		currentY += (targetY - currentY) * a;

		eyes.style.transform = `translate(${currentX}px, ${currentY}px)`;

		requestAnimationFrame(animate);
	};

	if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
		window.addEventListener("mousemove", onMouseMove);
		requestAnimationFrame(animate);
	}
</script>