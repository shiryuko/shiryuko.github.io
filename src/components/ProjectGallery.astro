---
import type { ProjectGalleryImage } from '../data/projects';

interface Props {
	images: ProjectGalleryImage[];
}

const { images } = Astro.props;
const galleryId = `gallery-${Math.random().toString(36).slice(2, 9)}`;
---

<section class="project-gallery" aria-label="Project gallery" data-gallery={galleryId}>
	<h2 class="project-gallery__title">Gallery</h2>

	<div class="project-gallery__viewport">
		<button
			type="button"
			class="project-gallery__control project-gallery__control--prev"
			aria-label="Previous image"
			data-gallery-prev
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="size-5"
				aria-hidden="true"
			>
				<path d="m15 18-6-6 6-6" />
			</svg>
		</button>

		<div class="project-gallery__track" data-gallery-track tabindex="0">
			{
				images.map((image, index) => (
					<figure class="project-gallery__slide" data-gallery-slide={index}>
						<img
							src={image.src}
							alt={image.alt}
							class="project-gallery__image"
							loading="lazy"
						/>
						{image.caption && (
							<figcaption class="project-gallery__caption">{image.caption}</figcaption>
						)}
					</figure>
				))
			}
		</div>

		<button
			type="button"
			class="project-gallery__control project-gallery__control--next"
			aria-label="Next image"
			data-gallery-next
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="size-5"
				aria-hidden="true"
			>
				<path d="m9 18 6-6-6-6" />
			</svg>
		</button>
	</div>

	<div class="project-gallery__dots" data-gallery-dots>
		{
			images.map((image, index) => (
				<button
					type="button"
					class="project-gallery__dot"
					aria-label={`Go to image ${index + 1}: ${image.alt}`}
					data-gallery-dot={index}
				/>
			))
		}
	</div>
</section>

<script>
	function initGallery(root: HTMLElement) {
		const track = root.querySelector<HTMLElement>('[data-gallery-track]');
		const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-gallery-slide]'));
		const prevButton = root.querySelector<HTMLButtonElement>('[data-gallery-prev]');
		const nextButton = root.querySelector<HTMLButtonElement>('[data-gallery-next]');
		const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-gallery-dot]'));

		if (!track || slides.length === 0) return;

		let activeIndex = 0;

		const updateDots = () => {
			dots.forEach((dot, index) => {
				dot.classList.toggle('project-gallery__dot--active', index === activeIndex);
			});
		};

		const scrollToIndex = (index: number) => {
			const boundedIndex = Math.max(0, Math.min(index, slides.length - 1));
			activeIndex = boundedIndex;
			slides[boundedIndex]?.scrollIntoView({
				behavior: 'smooth',
				block: 'nearest',
				inline: 'center',
			});
			updateDots();
		};

		const getClosestIndex = () => {
			const trackRect = track.getBoundingClientRect();
			const trackCenter = trackRect.left + trackRect.width / 2;

			let closestIndex = 0;
			let closestDistance = Number.POSITIVE_INFINITY;

			slides.forEach((slide, index) => {
				const slideRect = slide.getBoundingClientRect();
				const slideCenter = slideRect.left + slideRect.width / 2;
				const distance = Math.abs(trackCenter - slideCenter);

				if (distance < closestDistance) {
					closestDistance = distance;
					closestIndex = index;
				}
			});

			return closestIndex;
		};

		prevButton?.addEventListener('click', () => scrollToIndex(activeIndex - 1));
		nextButton?.addEventListener('click', () => scrollToIndex(activeIndex + 1));

		dots.forEach((dot) => {
			dot.addEventListener('click', () => {
				const index = Number(dot.dataset.galleryDot);
				scrollToIndex(index);
			});
		});

		track.addEventListener('scroll', () => {
			window.requestAnimationFrame(() => {
				activeIndex = getClosestIndex();
				updateDots();
			});
		});

		track.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') {
				event.preventDefault();
				scrollToIndex(activeIndex - 1);
			}

			if (event.key === 'ArrowRight') {
				event.preventDefault();
				scrollToIndex(activeIndex + 1);
			}
		});

		updateDots();
	}

	document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(initGallery);
</script>

<style>
	.project-gallery {
		margin-top: 3rem;
	}

	.project-gallery__title {
		margin: 0 0 1rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--color-neutral-500);
	}

	.project-gallery__viewport {
		position: relative;
	}

	.project-gallery__track {
		display: flex;
		gap: 1rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-behavior: smooth;
		scrollbar-width: none;
		padding: 0.25rem 2.75rem;
	}

	.project-gallery__track::-webkit-scrollbar {
		display: none;
	}

	.project-gallery__slide {
		flex: 0 0 min(100%, 36rem);
		margin: 0;
		scroll-snap-align: center;
	}

	.project-gallery__image {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		border-radius: 0.75rem;
		border: 1px solid var(--color-neutral-800);
		background-color: var(--color-neutral-900);
		object-fit: cover;
	}

	.project-gallery__caption {
		margin-top: 0.75rem;
		text-align: center;
		font-size: 0.875rem;
		color: var(--color-neutral-400);
	}

	.project-gallery__control {
		position: absolute;
		top: 50%;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 1px solid var(--color-neutral-700);
		border-radius: 9999px;
		background-color: color-mix(in srgb, var(--color-neutral-950) 85%, transparent);
		color: var(--color-neutral-300);
		cursor: pointer;
		transform: translateY(-50%);
		transition:
			border-color 0.2s ease,
			color 0.2s ease;
	}

	.project-gallery__control:hover {
		border-color: color-mix(in srgb, var(--color-red-500) 50%, transparent);
		color: var(--color-red-500);
	}

	.project-gallery__control--prev {
		left: 0;
	}

	.project-gallery__control--next {
		right: 0;
	}

	.project-gallery__dots {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 1rem;
	}

	.project-gallery__dot {
		width: 0.5rem;
		height: 0.5rem;
		border: 0;
		border-radius: 9999px;
		background-color: var(--color-neutral-700);
		cursor: pointer;
		transition: background-color 0.2s ease;
	}

	.project-gallery__dot--active {
		background-color: var(--color-red-500);
	}

	@media (prefers-reduced-motion: reduce) {
		.project-gallery__track {
			scroll-behavior: auto;
		}
	}
</style>
