---
import Layout from '../layouts/Layout.astro';
import { site } from '../config/site';
---

<Layout title=`Not found | ${site.name}`>
	<main>
        <section id="404" class="mx-auto max-w-6xl px-6 py-24">
            <div class="mx-auto max-w-3xl">
                <h2 class="mb-16 text-center text-3xl font-bold tracking-tight text-neutral-50 sm:text-4xl">Woops!</h2>
                <p class="text-center text-lg leading-relaxed text-neutral-400">Sorry, we couldn't find what you're looking for.</p>
            </div>
        </section>
	</main>
</Layout>
